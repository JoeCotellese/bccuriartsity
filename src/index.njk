---
layout: base.njk
---
{# ABOUTME: Home page — single-page layout: hero, about, gallery (from collection), contact. #}
{# Prose copy lives in src/sections/*.md; edit there, not here. #}
{% set hero = collections.section | section("hero") %}
{% set about = collections.section | section("about") %}

<section id="home">
  <div class="container">
    <div class="hero">
      <div>
        <p class="section-label">{{ hero.data.label }}</p>
        <h1>{{ hero.data.headline }}</h1>
        {{ hero.templateContent | safe }}
        <div class="hero-ctas">
          <a href="{{ hero.data.cta_href }}" role="button">{{ hero.data.cta_text }}</a>
          <details class="dropdown cta-shop-online">
            <summary role="button" class="outline">{{ hero.data.cta2_text }}</summary>
            <ul>
              <li><a href="{{ hero.data.cta2_href_chairish }}" target="_blank" rel="noopener noreferrer">Chairish</a></li>
              <li><a href="{{ hero.data.cta2_href_etsy }}" target="_blank" rel="noopener noreferrer">Etsy</a></li>
            </ul>
          </details>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/shop-interior.jpg" alt="Inside the shop, shelves and walls filled with curated antiques and art">
      </div>
    </div>
  </div>
</section>

<section id="about">
  <div class="container">
    <p class="section-label">{{ about.data.label }}</p>
    <h2>{{ about.data.heading }}</h2>
    {{ about.templateContent | safe }}
  </div>
</section>

<section id="gallery">
  <div class="container">
    <p class="section-label">Collection</p>
    <h2>Featured pieces</h2>
    {% if collections.gallery | length %}
    <div class="gallery-grid">
      {%- for item in collections.gallery | reverse %}
      {% if item.data.listingUrl %}
      <a class="gallery-item" href="{{ item.data.listingUrl }}" target="_blank" rel="noopener noreferrer">
      {% else %}
      <a class="gallery-item" href="{{ item.url }}">
      {% endif %}
        {% if item.data.image %}
          <img src="{{ item.data.image }}" alt="{{ item.data.title }}" loading="lazy">
        {% else %}
          <span class="gallery-item__placeholder">{{ item.data.title }}</span>
        {% endif %}
        {% if item.data.sold %}<span class="gallery-item__sold">Sold</span>{% endif %}
      </a>
      {%- endfor %}
    </div>
    {% else %}
    <p>New pieces coming soon. In the meantime, <a href="{{ site.social.chairish }}" target="_blank" rel="noopener noreferrer">browse the collection on Chairish</a>.</p>
    {% endif %}
  </div>
</section>
